{
  "name": "agentic-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Agentic IDE and Software Factory",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@agentic-ide/web",
    "dev:api": "bash scripts/dev-api.sh",
    "build:web": "npm run build --workspace=@agentic-ide/web",
    "lint:web": "npm run lint --workspace=@agentic-ide/web",
    "typecheck:web": "npm run typecheck --workspace=@agentic-ide/web",
    "test": "bash scripts/test.sh",
    "lint": "bash scripts/lint.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
