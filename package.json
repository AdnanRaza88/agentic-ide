{
  "name": "agentic-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Agentic IDE and Software Factory",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
